{
    "env": {
        "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
    },
    "permissions": {
        "allow": [
        "Bash(npm run lint)",
        "Bash(npm run test *)",
        "Read(~/.zshrc)"
        ],
        "deny": [
        "Bash(curl *)",
        "Read(./.env)",
        "Read(./.env.*)",
        "Read(./secrets/**)"
        ]
    },
    "model": "Opus",
    "alwaysThinkingEnabled": true
}